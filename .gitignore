# phaze — .gitignore
#
# This is the ONLY hand-maintained .gitignore in the repo. The other .gitignore
# files on disk (.beads/, .venv/, .mypy_cache/, .pytest_cache/, .ruff_cache/,
# services/*/.venv/) are written by their own tools and live inside directories
# that are already ignored here — they are not tracked and must not be edited.

# ---------------------------------------------------------------------------
# Python bytecode and C extensions
# ---------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
cython_debug/

# ---------------------------------------------------------------------------
# Packaging / build output
#
# Anchored to the repo root on purpose. Unanchored `build/`, `lib/`, `var/`,
# `target/` &c. match a directory of that name at ANY depth and would silently
# swallow real source (e.g. a future src/phaze/web/static/lib/).
# ---------------------------------------------------------------------------
/.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
/MANIFEST
/.installed.cfg
*.egg-info/
*.egg

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.hypothesis/
.tox/
.nox/
.cache
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
*.cover
*.py.cover

# ---------------------------------------------------------------------------
# Type checking and linting
# ---------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------------------------------------------------------------------------
# Environments and secrets
#
# Note the deliberate narrowness of `.env`: `.env.example` and
# `.env.example.agent` are tracked, so this must NOT be broadened to `.env.*`.
# ---------------------------------------------------------------------------
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.env
.envrc
.envrc.*
.pypirc
*.log

# Private key material. The app generates real private keys at runtime (see the
# certs/ section below), so this is a hard backstop independent of that path —
# nothing key-shaped is tracked anywhere in this repo today.
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Editors, tooling, OS
# ---------------------------------------------------------------------------
.vscode/
.spyderproject
.spyproject
.ropeproject
.cursorignore
.cursorindexingignore
*.swp
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Generated project artifacts
# ---------------------------------------------------------------------------

# ML models, downloaded by scripts/download-models.sh into the ./models/ bind
# mount. Ignore the CONTENTS (models/*) rather than the directory, so the
# committed models/.gitkeep survives — git cannot re-include a file whose parent
# DIRECTORY is excluded. phaze-he8m: keeping the mount point tracked means a
# clone materializes it owned by the operator (uid 1000) instead of letting
# dockerd auto-create it root:root.
#
# `models/*` contains a slash, so it is anchored to the repo root and does NOT
# touch the src/phaze/models/ source package.
models/*
!models/.gitkeep

# TLS material. phaze.cert_bootstrap generates a self-signed CA + leaf pair
# (phaze-ca.crt/.key, phaze-server.crt/.key) into the ./certs/ bind mount on
# first boot — two of those four files are PRIVATE KEYS. Same keep-the-mount-
# point-tracked reasoning as models/ above; `just up` mkdir -p's this directory.
certs/*
!certs/.gitkeep

# Build-time Tailwind: the standalone binary and the generated stylesheet are
# produced by `just tailwind` (local) / the Dockerfile css-builder stage
# (image), never committed. Source of truth is assets/src/app.css.
/bin/
src/phaze/static/css/app.css

# phaze-17ni3: Playwright trace zips the browser suite writes on a FAILING test
# (tests/browser/conftest.py, "CI diagnosability"). Local diagnostic output, uploaded as a CI
# artifact rather than committed.
/test-results/

# graphify cache and HTML viz. The viz is unbuildable past graphify's node cap
# (this graph is too large), so it can only ever be a stale artifact — the
# queryable graph.json + GRAPH_REPORT.md are the source of truth.
graphify-out/cache/
graphify-out/graph.html
.planning/graphs/graph.html

# ---------------------------------------------------------------------------
# Local agent / tooling state — machine-specific, never shared across clones
# ---------------------------------------------------------------------------

# Claude Code project-local state (settings, caches, generated CLAUDE.md).
# The repo-root CLAUDE.md is the tracked one.
.claude/

# Git worktree checkouts rooted inside the repo (bh `wt/bead/issue/<id>` &c.).
.worktrees/

# beads issue tracker — local Dolt-backed store. Synced to the Dolt remote via
# `bd dolt push`, not through git. `.beads/` covers everything underneath it,
# including the credential key and proxieddb/; the root-level entries are the
# stray-file backstop.
.beads/
.dolt/
*.db
*.sqlite3*
.beads-credential-key

# bv (beads viewer) local config and caches
.bv/

# repowise index / tool state — derived from source, not project source
.repowise/

# MCP server config (machine-specific paths and credentials)
.mcp.json

.playwright-mcp/
.superpowers/

# Update script backups
.backups/

# Beadhive gate lock — transient, written per-session
/.beads.gate.lock

# Codex agent state (sibling of .claude/, machine-local)
/.codex/

# Agent instruction file — mirrors CLAUDE.md, kept local rather than tracked
/AGENTS.md
.fast-selection.txt
